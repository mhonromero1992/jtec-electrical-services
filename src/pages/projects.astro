---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SizeChart from '../components/SizeChart.astro';
import MapSection from '../components/MapSection.astro';
import { projects, totalKwp, formatDate, formatKwp, type Province } from '../data/projects';

const provinces: Province[] = ['Rizal', 'Metro Manila', 'Bulacan', 'Tarlac', 'Pangasinan'];
const total = totalKwp.toLocaleString('en-PH', { maximumFractionDigits: 2 });
---

<Base
  title="Projects | JTEC Electrical Services"
  description={`Fourteen solar installations from JTEC's log, ${total} kWp in total, from Antipolo City and Quezon City to Bulacan, Tarlac and Pangasinan, with photographs of each.`}
  firstChapter="amber"
>
  <section class="pj-hero" data-chapter="amber" aria-labelledby="page-title">
    <div class="wrap">
      <div class="pj-hero__head">
        <h1 id="page-title" class="t-display pj-hero__title" data-reveal>Solar installations across Luzon</h1>
        <p class="t-lead pj-hero__lede" data-reveal>
          {projects.length} systems from JTEC’s installation log, {total} kWp in all, with the photographs taken on site. Hybrid
          setups with battery storage make up all but one of them.
        </p>
      </div>
      <div class="pj-hero__chart" data-reveal="fade">
        <SizeChart />
      </div>
    </div>
  </section>

  <section class="cat chapter" data-chapter="stone" aria-labelledby="cat-title">
    <div class="wrap">
      <div class="cat__head">
        <h2 id="cat-title" class="t-head" data-reveal>Every installation, photographed</h2>
        <div class="cat__filters" role="group" aria-label="Filter installations" hidden>
          <div class="cat__group" role="group" aria-label="System type">
            <button type="button" class="chip" data-filter="type" data-value="all" aria-pressed="true">All systems</button>
            <button type="button" class="chip" data-filter="type" data-value="Hybrid" aria-pressed="false">Hybrid</button>
            <button type="button" class="chip" data-filter="type" data-value="Grid-tied" aria-pressed="false">Grid-tied</button>
          </div>
          <div class="cat__group" role="group" aria-label="Province">
            <button type="button" class="chip" data-filter="province" data-value="all" aria-pressed="true">All provinces</button>
            {
              provinces.map((p) => (
                <button type="button" class="chip" data-filter="province" data-value={p} aria-pressed="false">
                  {p}
                </button>
              ))
            }
          </div>
          <p class="cat__count" aria-live="polite">Showing all {projects.length} installations</p>
        </div>
      </div>

      <div class="cat__grid">
        {
          projects.map((p, i) => (
            <article class="entry" id={p.slug} data-type={p.type} data-province={p.province ?? 'none'} aria-labelledby={`${p.slug}-title`}>
              <div class="entry__photos">
                <Image src={p.photos[0]} alt={p.alts[0]} widths={[240, 360]} sizes="(max-width: 700px) 46vw, (max-width: 1100px) 23vw, 210px" loading={i < 3 ? 'eager' : 'lazy'} />
                <Image src={p.photos[1]} alt={p.alts[1]} widths={[240, 360]} sizes="(max-width: 700px) 46vw, (max-width: 1100px) 23vw, 210px" loading={i < 3 ? 'eager' : 'lazy'} />
              </div>
              <h3 id={`${p.slug}-title`} class="entry__title">
                <span class="t-num">{formatKwp(p.kwp)}</span> {p.type === 'Hybrid' ? 'hybrid' : 'grid-tied'}
              </h3>
              <dl class="entry__specs">
                <div>
                  <dt>Battery</dt>
                  <dd class="t-num">{p.batteryAh ? `${p.batteryAh} Ah` : 'None (grid-tied)'}</dd>
                </div>
                <div>
                  <dt>Location</dt>
                  <dd>{p.location ?? 'Not listed in the profile'}</dd>
                </div>
                <div>
                  <dt>Date</dt>
                  <dd class="t-num">{formatDate(p.date) ?? 'Not dated in the profile'}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>

      <div class="cat__empty" hidden>
        <p class="t-lead">No installation in the log matches both filters.</p>
        <button type="button" class="btn btn--small cat__reset">Show all installations</button>
      </div>
    </div>
  </section>

  <MapSection
    id="where"
    title="Where the systems are"
    intro="Each amber dot is a place in the log, sized by the capacity installed there. White rings mark the major electrical projects in JTEC’s work experience."
  />
</Base>

<style>
  .pj-hero {
    padding-top: calc(var(--header-h) + clamp(48px, 9vh, 120px));
    padding-bottom: var(--section-y);
  }

  .pj-hero__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 28px;
  }

  .pj-hero__title {
    grid-column: 1 / span 10;
    font-size: min(var(--step-display), 8.2vw);
  }

  .pj-hero__lede {
    grid-column: 1 / span 6;
  }

  .pj-hero__chart {
    margin-top: clamp(56px, 7vw, 104px);
  }

  /* ---------------------------------------------- catalogue */
  .cat__head {
    display: grid;
    gap: 28px;
  }

  .cat__filters:not([hidden]) {
    display: grid;
    gap: 12px;
  }

  .cat__group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cat .chip {
    background: var(--surface);
  }

  .cat .chip[aria-pressed='true'] {
    background: var(--c-ink);
    color: var(--c-paper);
  }

  .cat__count {
    font-size: var(--step-small);
    font-weight: 560;
    color: var(--muted);
  }

  .cat__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(40px, 4vw, 64px) var(--gutter);
    margin-top: clamp(40px, 5vw, 72px);
  }

  .entry {
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .entry[hidden] {
    display: none;
  }

  .entry__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .entry__photos :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--surface);
  }

  .entry__title {
    margin-top: 18px;
    font-size: var(--step-lead);
    font-weight: 740;
    font-stretch: 104%;
    letter-spacing: -0.015em;
  }

  .entry__specs {
    display: grid;
    gap: 4px;
    margin-top: 10px;
  }

  .entry__specs > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 12px;
    font-size: var(--step-small);
    line-height: 1.5;
  }

  .entry__specs dt {
    color: var(--muted);
    font-weight: 560;
  }

  .entry__specs dd {
    font-weight: 560;
  }

  .entry:target .entry__title {
    color: var(--c-blue);
  }

  .cat__empty:not([hidden]) {
    display: grid;
    justify-items: start;
    gap: 20px;
    margin-top: 48px;
  }

  @media (max-width: 1100px) {
    .cat__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .pj-hero__title,
    .pj-hero__lede {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .cat__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Filters only appear when this script runs; without it every installation stays listed.
  document.querySelectorAll<HTMLElement>('.cat').forEach((cat) => {
    const filters = cat.querySelector<HTMLElement>('.cat__filters')!;
    const chips = Array.from(cat.querySelectorAll<HTMLButtonElement>('.chip'));
    const entries = Array.from(cat.querySelectorAll<HTMLElement>('.entry'));
    const count = cat.querySelector<HTMLElement>('.cat__count')!;
    const empty = cat.querySelector<HTMLElement>('.cat__empty')!;
    const state = { type: 'all', province: 'all' };
    filters.hidden = false;

    const apply = () => {
      let shown = 0;
      for (const e of entries) {
        const ok =
          (state.type === 'all' || e.dataset.type === state.type) &&
          (state.province === 'all' || e.dataset.province === state.province);
        e.hidden = !ok;
        if (ok) shown++;
      }
      chips.forEach((c) => c.setAttribute('aria-pressed', String(state[c.dataset.filter as 'type' | 'province'] === c.dataset.value)));
      count.textContent =
        shown === entries.length ? `Showing all ${shown} installations` : `Showing ${shown} of ${entries.length} installations`;
      empty.hidden = shown > 0;
    };

    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        state[chip.dataset.filter as 'type' | 'province'] = chip.dataset.value ?? 'all';
        apply();
      }),
    );
    cat.querySelector('.cat__reset')?.addEventListener('click', () => {
      state.type = 'all';
      state.province = 'all';
      apply();
    });

    // a link to an entry (from the chart or the home page) should never land on a hidden one
    const reveal = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const target = id ? document.getElementById(id) : null;
      if (target && cat.contains(target) && target.hidden) {
        state.type = 'all';
        state.province = 'all';
        apply();
        target.scrollIntoView();
      }
    };
    window.addEventListener('hashchange', reveal);
    // a click on a link to an entry the filters are hiding clears them first (covers a repeat click on the same hash)
    document.addEventListener('click', (e) => {
      const link = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href*="#"]');
      if (!link || link.pathname !== location.pathname) return;
      const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (target && cat.contains(target) && target.hidden) {
        state.type = 'all';
        state.province = 'all';
        apply();
      }
    });
    reveal();
  });
</script>
