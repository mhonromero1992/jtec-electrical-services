---
import { Image } from 'astro:assets';
import { team } from '../data/people';
import { site, type ChapterName } from '../data/site';

interface Props {
  id?: string;
  title?: string;
  chapter?: ChapterName;
}

const { id = 'team', title = 'The people on the job', chapter = 'stone' } = Astro.props;
const leads = team.filter((p) => p.lead);
const rest = team.filter((p) => !p.lead);
---

<section class="team chapter" data-chapter={chapter} aria-labelledby={`${id}-title`}>
  <div class="wrap team__grid">
    <div class="team__head">
      <h2 id={`${id}-title`} class="t-head" data-reveal>{title}</h2>
      <p class="t-lead team__intro" data-reveal>
        {site.name} is led by experienced professionals and supported by a dedicated workforce of {site.workforce}.
      </p>
    </div>

    <ul class="team__leads" aria-label="Management">
      {
        leads.map((p) => (
          <li class="person person--lead" data-reveal>
            <div class="person__photo">
              <Image src={p.photo} alt={`Portrait of ${p.name}`} widths={[320, 480, 640]} sizes="(max-width: 900px) 46vw, 30vw" loading="lazy" />
            </div>
            <p class="person__name">{p.name}</p>
            <p class="person__role">{p.role}</p>
          </li>
        ))
      }
    </ul>

    <ul class="team__rest" aria-label="Engineering, finance and purchasing">
      {
        rest.map((p) => (
          <li class="person" data-reveal>
            <div class="person__photo">
              <Image src={p.photo} alt={`Portrait of ${p.name}`} widths={[240, 360, 480]} sizes="(max-width: 900px) 46vw, 22vw" loading="lazy" />
            </div>
            <p class="person__name">{p.name}</p>
            <p class="person__role">{p.role}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .team__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: clamp(48px, 5vw, 72px);
  }

  .team__head {
    grid-column: 1 / span 4;
    align-self: end;
  }

  .team__intro {
    margin-top: 24px;
    color: var(--muted);
  }

  .team__leads {
    grid-column: 5 / span 8;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
  }

  .team__rest {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gutter);
  }

  .person__photo {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--surface);
  }

  .person--lead .person__photo {
    background: var(--c-navy);
  }

  .person__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    transition: transform 900ms var(--ease);
  }

  .person:hover .person__photo :global(img) {
    transform: scale(1.03);
  }

  .person__name {
    margin-top: 16px;
    font-size: var(--step-body);
    font-weight: 700;
    font-stretch: 104%;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .person--lead .person__name {
    font-size: var(--step-lead);
    font-weight: 720;
  }

  .person__role {
    margin-top: 2px;
    color: var(--muted);
    font-size: var(--step-small);
    font-weight: 520;
  }

  @media (max-width: 1100px) {
    .team__head,
    .team__leads {
      grid-column: 1 / -1;
    }
    .team__rest {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
