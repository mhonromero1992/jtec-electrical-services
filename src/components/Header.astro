---
import Logo from './Logo.astro';
import { nav, site, chapterTheme, type ChapterName } from '../data/site';

interface Props {
  firstChapter: ChapterName;
}

const { firstChapter } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => path === href;
---

<header class="site-header" data-theme={chapterTheme[firstChapter]} data-chapter={firstChapter} data-at-top="true">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="site-header__bar wrap">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <Logo part="mark" class="brand__mark" />
      <Logo part="wordmark" class="brand__word" />
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--small site-header__cta" href="/contact/">Request a quotation</a>

    <a class="menu-link" href="#footer-nav">Menu</a>
    <button class="menu-button" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="site-menu">
      <span class="menu-button__label">Menu</span>
      <span class="menu-button__icon" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<dialog id="site-menu" class="menu-sheet" data-chapter="dawn" aria-label="Site menu">
  <div class="menu-sheet__inner wrap">
    <div class="menu-sheet__top">
      <a href="/" class="brand" aria-label={`${site.name}, home`}>
        <Logo part="mark" class="brand__mark" />
        <Logo part="wordmark" class="brand__word" />
      </a>
      <button class="menu-close" type="button">Close</button>
    </div>
    <nav aria-label="Menu">
      <ul class="menu-sheet__links">
        <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu-sheet__foot">
      <a class="btn btn--block" href="/contact/">Request a quotation</a>
      <p>
        <a href={site.phoneHref}>{site.phoneDisplay}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </div>
</dialog>

<style>
  @property --logo-navy {
    syntax: '<color>';
    inherits: true;
    initial-value: #014a7c;
  }
  @property --logo-ink {
    syntax: '<color>';
    inherits: true;
    initial-value: #111111;
  }
  @property --hdr-ink {
    syntax: '<color>';
    inherits: true;
    initial-value: #f4f3ee;
  }
  @property --hdr-bg {
    syntax: '<color>';
    inherits: true;
    initial-value: rgb(3 43 79 / 0);
  }

  .site-header {
    --hdr-ink: var(--c-paper);
    --hdr-bg: rgb(3 43 79 / 0.62);
    --logo-navy: var(--c-paper);
    --logo-ink: var(--c-paper);
    --logo-amber: var(--c-amber);
    --focus: var(--c-amber);
    --bg: var(--c-dawn);
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    color: var(--hdr-ink);
    view-transition-name: site-header;
    transition:
      --hdr-ink var(--t-colour) var(--ease),
      --hdr-bg var(--t-colour) var(--ease),
      --logo-navy var(--t-colour) var(--ease),
      --logo-ink var(--t-colour) var(--ease),
      transform 420ms var(--ease);
  }

  .site-header[data-theme='light'] {
    --hdr-ink: var(--c-ink);
    --hdr-bg: rgb(241 240 235 / 0.68);
    --logo-navy: #014a7c;
    --logo-ink: #111111;
    --focus: var(--c-blue);
    --bg: var(--c-stone);
  }

  /* the glass takes a tint of the chapter it floats over */
  .site-header[data-chapter='blue'] {
    --hdr-bg: rgb(4 97 189 / 0.66);
    --bg: var(--c-blue);
  }

  .site-header[data-chapter='navy'] {
    --hdr-bg: rgb(0 75 126 / 0.66);
    --bg: var(--c-navy);
  }

  .site-header[data-chapter='night'] {
    --hdr-bg: rgb(1 24 44 / 0.66);
    --bg: var(--c-night);
  }

  .site-header[data-chapter='amber'] {
    --hdr-bg: rgb(255 179 3 / 0.72);
    --bg: var(--c-amber);
    --focus: var(--c-ink);
  }

  /* over the amber chapter the amber button would vanish, so it turns navy */
  .site-header[data-chapter='amber'] .site-header__cta {
    --btn-bg: var(--c-ink);
    --btn-ink: var(--c-amber);
  }

  /* the glass surface (one of two on the site): only once the page has scrolled */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--hdr-bg);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    backdrop-filter: blur(18px) saturate(1.5);
    box-shadow: inset 0 -1px 0 rgb(255 255 255 / 0.08);
    opacity: 1;
    transition: opacity var(--t-colour) var(--ease);
  }

  .site-header[data-theme='light']::before {
    box-shadow: inset 0 -1px 0 rgb(6 34 61 / 0.06);
  }

  .site-header[data-at-top='true']::before {
    opacity: 0;
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header::before {
      background: var(--bg);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header::before {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: var(--bg);
    }
  }

  .site-header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.5vw, 40px);
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-right: auto;
    color: inherit;
    text-decoration: none;
    min-height: 48px;
  }

  .brand :global(.brand__mark) {
    width: auto;
    height: 40px;
  }

  .brand :global(.brand__word) {
    width: auto;
    height: 22px;
  }

  .site-nav ul {
    display: flex;
    gap: clamp(8px, 1.6vw, 28px);
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 4px;
    font-size: 0.97rem;
    font-weight: 560;
    font-stretch: 104%;
    text-decoration: none;
    color: inherit;
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: 8px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 420ms var(--ease);
  }

  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-header__cta {
    --btn-bg: var(--c-amber);
    --btn-ink: var(--c-ink);
  }

  .menu-button {
    display: none;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    min-width: 44px;
    padding: 0 4px 0 10px;
    border: 0;
    background: transparent;
    color: inherit;
    font-weight: 600;
    font-stretch: 104%;
  }

  /* without JavaScript the menu is a jump to the footer navigation */
  .menu-link {
    display: none;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-decoration: none;
  }

  .menu-button__icon {
    position: relative;
    display: inline-grid;
    gap: 5px;
    width: 22px;
  }

  .menu-button__icon span {
    height: 2px;
    background: currentColor;
    transition: transform var(--t-colour) var(--ease);
  }

  .menu-button:hover .menu-button__icon span:last-child {
    transform: scaleX(0.6);
    transform-origin: right;
  }

  @media (max-width: 1040px) {
    .site-nav {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .site-header__cta {
      display: none;
    }
  }

  @media (max-width: 1040px) {
    :global(html.js) .menu-button {
      display: inline-flex;
    }
    :global(html:not(.js)) .menu-link {
      display: inline-flex;
    }
  }

  @media (max-width: 420px) {
    .brand :global(.brand__word) {
      height: 18px;
    }
    .brand :global(.brand__mark) {
      height: 34px;
    }
  }

  /* ---------------------------------------------------------- menu sheet */
  .menu-sheet {
    --logo-navy: var(--c-paper);
    --logo-ink: var(--c-paper);
    --logo-amber: var(--c-amber);
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    clip-path: circle(0% at calc(100% - 44px) 36px);
    transition:
      clip-path 620ms var(--ease),
      overlay 620ms allow-discrete,
      display 620ms allow-discrete;
  }

  .menu-sheet[open] {
    clip-path: circle(150% at calc(100% - 44px) 36px);
  }

  @starting-style {
    .menu-sheet[open] {
      clip-path: circle(0% at calc(100% - 44px) 36px);
    }
  }

  .menu-sheet::backdrop {
    background: rgb(1 24 44 / 0.4);
  }

  .menu-sheet__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-bottom: max(24px, env(safe-area-inset-bottom));
  }

  .menu-sheet__top {
    display: flex;
    align-items: center;
    height: var(--header-h);
  }

  .menu-close {
    min-height: 44px;
    padding: 0 6px;
    border: 0;
    background: transparent;
    font-weight: 600;
    font-stretch: 104%;
  }

  .menu-sheet__links {
    display: grid;
    gap: 4px;
    margin-top: clamp(24px, 6vh, 64px);
  }

  .menu-sheet__links a {
    display: block;
    padding: 6px 0;
    font-size: clamp(2.5rem, 11vw, 4.5rem);
    font-weight: 800;
    font-stretch: 108%;
    line-height: 1;
    letter-spacing: -0.035em;
    text-decoration: none;
    transition: color var(--t-colour) var(--ease);
  }

  .menu-sheet__links a[aria-current='page'] {
    color: var(--c-amber);
  }

  .menu-sheet__links a:hover {
    color: var(--c-amber);
  }

  .menu-sheet__foot {
    display: grid;
    gap: 20px;
    margin-top: auto;
    padding-top: 48px;
  }

  .menu-sheet__foot p {
    color: var(--muted);
    line-height: 1.9;
  }

  .menu-sheet__foot p a {
    text-decoration: none;
  }

  :global(html:has(.menu-sheet[open])) {
    overflow: hidden;
  }
</style>

<script>
  import { chapterTheme, type ChapterName } from '../data/site';

  const header = document.querySelector<HTMLElement>('.site-header');
  const menu = document.querySelector<HTMLDialogElement>('#site-menu');
  const openBtn = document.querySelector<HTMLButtonElement>('.menu-button');
  const closeBtn = menu?.querySelector<HTMLButtonElement>('.menu-close');

  if (header) {
    // The header takes the ink of the chapter currently under it.
    let ticking = false;
    let lastY = window.scrollY;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      header.dataset.atTop = String(y < 12);
      const probeY = header.offsetHeight / 2;
      const under = document
        .elementsFromPoint(window.innerWidth / 2, probeY)
        .find((el) => !header.contains(el) && !(el instanceof HTMLDialogElement));
      const chapter = under?.closest<HTMLElement>('[data-chapter]')?.dataset.chapter as ChapterName | undefined;
      if (chapter && chapterTheme[chapter]) {
        header.dataset.theme = chapterTheme[chapter];
        header.dataset.chapter = chapter;
      }
      // tuck the bar away while reading downwards, bring it back on any upward scroll
      const goingDown = y > lastY + 4;
      const goingUp = y < lastY - 4;
      if (goingDown && y > 480) header.dataset.hidden = 'true';
      else if (goingUp || y < 480) header.dataset.hidden = 'false';
      lastY = y;
    };
    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    header.addEventListener('focusin', () => (header.dataset.hidden = 'false'));
    update();
  }

  if (menu && openBtn && closeBtn) {
    const open = () => {
      menu.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    };
    const close = () => menu.close();
    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    menu.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    menu.addEventListener('click', (e) => {
      if (e.target === menu) close();
    });
    // Close the sheet if the viewport grows past the breakpoint while it is open.
    matchMedia('(min-width: 1041px)').addEventListener('change', (e) => {
      if (e.matches && menu.open) close();
    });
  }
</script>
