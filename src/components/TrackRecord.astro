---
import { experience } from '../data/people';
import type { ChapterName } from '../data/site';

interface Props {
  id?: string;
  chapter?: ChapterName;
}

const { id = 'record', chapter = 'navy' } = Astro.props;
---

<section class="record chapter" data-chapter={chapter} aria-labelledby={`${id}-title`}>
  <div class="wrap record__grid">
    <div class="record__head">
      <h2 id={`${id}-title`} class="t-head" data-reveal>Electrical work since 2016</h2>
      <p class="t-lead record__intro" data-reveal>
        Before and alongside solar: the work experience listed in JTEC’s company profile, from a BPO building in Makati
        to the North to South Railway Project.
      </p>
    </div>
    <ol class="record__list">
      {
        experience.map((e) => (
          <li class="record__item" data-reveal>
            <span class="record__years">{e.years}</span>
            <span class="record__name">{e.name}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .record__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 48px;
  }

  .record__head {
    grid-column: 1 / span 6;
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 40px);
  }

  .record__intro {
    margin-top: 24px;
    color: var(--muted);
  }

  .record__list {
    grid-column: 7 / span 6;
    display: grid;
    gap: clamp(20px, 2.4vw, 32px);
  }

  .record__item {
    display: grid;
    gap: 4px;
  }

  .record__years {
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 4rem);
    font-weight: 800;
    font-stretch: 110%;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--c-amber);
  }

  .record__name {
    font-size: var(--step-lead);
    font-weight: 560;
    line-height: 1.3;
  }

  @media (max-width: 1100px) {
    .record__head,
    .record__list {
      grid-column: 1 / -1;
      position: static;
    }
  }
</style>
