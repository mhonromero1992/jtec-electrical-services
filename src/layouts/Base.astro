---
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, chapterColor, type ChapterName } from '../data/site';

interface Props {
  title: string;
  description: string;
  firstChapter: ChapterName;
  footerCta?: boolean;
}

const { title, description, firstChapter, footerCta = true } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og-image.jpg', Astro.site).href : '/og-image.jpg';

const business = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  name: site.name,
  description:
    'Electrical contractor with a solar division, JTEC Solar Installation: solar power system design, supply and installation, electrical design, installation and maintenance.',
  telephone: '+639760503461',
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address.locality,
    addressRegion: site.address.province,
    addressCountry: 'PH',
  },
  areaServed: 'Luzon, Philippines',
  ...(Astro.site ? { url: Astro.site.href } : {}),
};
---

<!doctype html>
<html lang="en-PH" data-first-chapter={firstChapter}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={chapterColor[firstChapter]} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_PH" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        // never leave content hidden if the motion script fails to start
        setTimeout(function () {
          if (!window.__motionReady) document.documentElement.classList.remove('motion');
        }, 3500);
      }
    </script>
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
    </style>
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
  </head>
  <body>
    <Header firstChapter={firstChapter} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer cta={footerCta} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
